    {
        hp -= damage;
        if (hp < 1) is_destroyed = true;
    }
};
class Entity
{
private:
    char team;
    int i;
    int unit_tier;
    int hp;
    int i_nature;
    sf::Sprite unit;
    sf::Texture texture;
    sf::Texture grey;
    int prev_i;
    sf::Vector2f p;
    bool check=true;

public:
    Entity(char in_team, int in_i, int unit_tier_in, int hp_in)
    {
        i = in_i;
        team = in_team;
        unit_tier = unit_tier_in;
        hp = hp_in;
    }
    void spawn()
    {
        if (unit_tier == 0)
        {
            texture.loadFromFile("images/robot_worker.png");
        }
        unit.setTexture(texture);
        unit.setScale(0.19, 0.19);
        unit.setPosition(map[i].x + hor_space, map[i].y + ver_space);
    }
    sf::Sprite return_drawing()
    {
        return unit;
    }
    int return_i()
    {
        return i;
    }
    void change(int in_i)
    {
        i = in_i;
    }
    void move_Z(float left_border, float right_border, float upper_border, float down_border, sf::Sprite& unit,Entity& entiy)
    {
        check = true;
        sf::Vector2f position = unit.getPosition();
        float distance = side * sqrt(3) - 3;
        if (position.x - distance<left_border || position.y + distance >down_border) check = false;
        if(check)
        {
            p = unit.getPosition();
            prev_i = entiy.return_i();
            unit.move((sqrt(3) * side * cos(120.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(120.0f * 3.14159f / 180.0f)));
            if (abs(int(unit.getPosition().x - map[entiy.return_i() + 1].x)) <= horiz_shift && abs(int(unit.getPosition().y - map[entiy.return_i() + 1].y)) <= vert_shift)
                entiy.change(entiy.return_i() + 1);
            else entiy.change(entiy.return_i() - 16);

            if (map[entiy.return_i()].status == 'w')
            {
                unit.setPosition(p);
                entiy.change(prev_i);

            }
        }
    }
    void move_X(float left_border, float right_border, float upper_border, float down_border, sf::Sprite& unit, Entity& entity)
    {
        check = true;
        sf::Vector2f position = unit.getPosition();
        float distance = side * sqrt(3) - 3;
        if (position.x + distance > right_border || position.y + distance > down_border) check = false;
        if (check)
        {
            p = unit.getPosition();
            prev_i = entity.return_i();
            unit.move((sqrt(3) * side * cos(60.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(60.0f * 3.14159f / 180.0f)));
            if (abs(int(map[entity.return_i() + 1].x - unit.getPosition().x)) <= horiz_shift && abs(int(map[entity.return_i() + 1].y - unit.getPosition().y) <= vert_shift))
                entity.change(entity.return_i() + 1);
            else entity.change(entity.return_i() + 18);
            if (map[entity.return_i()].status == 'w')
            {
                unit.setPosition(p);
                entity.change(prev_i);
            }
         }
        
    }
    void move_D(float left_border, float right_border, float upper_border, float down_border, sf::Sprite& unit, Entity& entity)
    {
        check = true;
        sf::Vector2f position = unit.getPosition();
        float distance = side * sqrt(3) + 5;
        if (position.x + distance > right_border)
            check = false;
        if (check)
        {
            p = unit.getPosition();
            prev_i = entity.return_i();
            unit.move((sqrt(3) * side * cos(0.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(0.0f * 3.14159f / 180.0f)));
            entity.change(entity.return_i() + 17);
            if (map[entity.return_i()].status == 'w')
            {
                unit.setPosition(p);
                entity.change(prev_i);
            }
        }
    }
    void move_E(float left_border, float right_border, float upper_border, float down_border, sf::Sprite& unit, Entity& entity)
    {
        check = true;
        sf::Vector2f position = unit.getPosition();
        float distance = side * sqrt(3), vert_distance = side * sqrt(3) * 2;
        if (position.x + distance > right_border || position.y - vert_distance < upper_border)
            check = false;
        if (check)
        {
            p = unit.getPosition();
            prev_i = entity.return_i();
            unit.move((sqrt(3) * side * cos(300.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(300.0f * 3.14159f / 180.0f)));
            if (abs(int(map[entity.return_i() - 1].x - unit.getPosition().x)) <= horiz_shift && abs(int(map[entity.return_i() - 1].y - unit.getPosition().y) <= vert_shift))
                entity.change(entity.return_i() - 1);
            else entity.change(entity.return_i() + 16);
            if (map[entity.return_i()].status == 'w')
            {
                unit.setPosition(p);
                entity.change(prev_i);

            }
        }
    }
    void move_W(float left_border, float right_border, float upper_border, float down_border, sf::Sprite& unit, Entity& entity)
    {
        check = true;
        sf::Vector2f position = unit.getPosition();
        float distance = side * sqrt(3), vert_distance = side * sqrt(3) * 2;
        if (position.x - distance < left_border || position.y - vert_distance < upper_border)
            check = false;
        if (check)
        {
            p = unit.getPosition();
            prev_i = entity.return_i();
            unit.move((sqrt(3) * side * cos(240.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(240.0f * 3.14159f / 180.0f)));
            if (abs(int(map[entity.return_i() - 1].x - unit.getPosition().x)) <= horiz_shift && abs(int(map[entity.return_i() - 1].y - unit.getPosition().y) <= vert_shift))
                entity.change(entity.return_i() - 1);
            else entity.change(entity.return_i() - 18);
            if (map[entity.return_i()].status == 'w')
            {
                unit.setPosition(p);
                entity.change(prev_i);

            }
        }
    }
    void move_A(float left_border, float right_border, float upper_border, float down_border, sf::Sprite& unit, Entity& entiy)
    {
        check = true;
        sf::Vector2f position = unit.getPosition();
        float distance = side * sqrt(3) * 1.5;
        if (position.x - distance < left_border)
            check = false;
        if (check)
        {
            p = unit.getPosition();
            prev_i = entiy.return_i();
            unit.move((sqrt(3) * side * cos(180.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(180.0f * 3.14159f / 180.0f)));
            entiy.change(entiy.return_i() - 17);
            if (map[entiy.return_i()].status == 'w')
            {
                unit.setPosition(p);
                entiy.change(prev_i);

            }
       }
    }
};

