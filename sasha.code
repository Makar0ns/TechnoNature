    text2.move(1600, 730);
    window.draw(text2);
    text3.setFont(font);
    text3.setCharacterSize(18);
    text3.setString("D - move right");
    text3.setFillColor(sf::Color::White);
    text3.move(1600, 760);
    window.draw(text3);
    text4.setFont(font);
    text4.setCharacterSize(18);
    text4.setString("X - move lower right");
    text4.setFillColor(sf::Color::White);
    text4.move(1600, 790);
    window.draw(text4);
    text5.setFont(font);
    text5.setCharacterSize(18);
    text5.setString("Z - move lower left");
    text5.setFillColor(sf::Color::White);
    text5.move(1600, 820);
    window.draw(text5);
    text6.setFont(font);
    text6.setCharacterSize(18);
    text6.setString("A - move left");
    text6.setFillColor(sf::Color::White);
    text6.move(1600, 850);
    window.draw(text6);
    window.draw(menu);
}
class Townhall
{
private:
    int side;
    char team;
    bool is_destroyed = false;
    int hp = 10;
    int i = 0;
    int income_gold = 1;
    int income_etherium = 0;
    int income_pandorium = 0;
    int balance_gold = 4;
    int balance_etherium = 0;
    int balance_pandorium = 0;
    sf::CircleShape hexagon;
    sf::Texture texture;

public:
    Townhall(int in_i, char team_in, int in_side)
    {
        i = in_i;
        team = team_in;
        side = in_side;
    }
    void draw(sf::RenderWindow& window)
    {
        sf::CircleShape hexagon(side, 6);
        if (team == 'n')
            texture.loadFromFile("Images\\tower_nature.png");
        else texture.loadFromFile("Images\\tower_robot.png");
        hexagon.setPosition(map[i].x, map[i].y);
        hexagon.setTexture(&texture);
        window.draw(hexagon);
    }
    void change_hp(int damage)
    {
        hp -= damage;
        if (hp < 1) is_destroyed = true;
    }
    int is_destroyed_return()
    {
        return is_destroyed;
    }

    int return_balance_gold()
    {
        return balance_gold;
    }
    int return_balance_etherium()
    {
        return balance_etherium;
    }
    int return_balance_pandorium()
    {
        return balance_pandorium;
    }
    void update_gold(int mine_g_captured)
    {
        balance_gold += 1 + mine_g_captured * 2;
    }
    void update_etherium(int mine_e_captured)
    {
        balance_etherium += mine_e_captured;
    }
    void update_pandorium(int mine_p_captured)
    {
        balance_pandorium += mine_p_captured;
    }


};
int main()
{
    int turns_left;

    char selected_team = 'n';
    int turn_cnt = 1;

    sf::Clock clock;
    sf::RenderWindow window(sf::VideoMode(1920, 1080), "TechnoNature");
    sf::Sprite button;

    bool spawned = true;
    bool allow_move;
    float dx = 0, dy = 0;
    int j;
    int balance_g;
    int numberOfHexagons_horizontal = 17, numberOfHexagons_vertical = 16;
    int sign = 1;
    float startX = 400;
    float startY = 25;
    float left_border = startX - side * 2, upper_border = startY - side;
    float right_border = startX + side * (numberOfHexagons_horizontal - 3) * 2, down_border = startY + side * (numberOfHexagons_vertical + 1) * 1.5;
    create_map(numberOfHexagons_horizontal, numberOfHexagons_vertical, map);
    create_map_coords(side, numberOfHexagons_horizontal, numberOfHexagons_vertical, sign, startX, startY);
    sf::Sprite unit;
    std::vector <Entity> entities;
    entities.push_back(Entity('r', 263, 0, 60));
    entities.push_back(Entity('n', 25, 0, 60));
    entities.push_back(Entity('n', 40, 1, 150));
    entities.push_back(Entity('r', 260, 1, 150));
    entities.push_back(Entity('n', 41, 2, 120));
    entities.push_back(Entity('r', 261, 2, 120));
    entities.push_back(Entity('n', 42, 3, 180));
    entities.push_back(Entity('r', 262, 3, 180));
    entities.push_back(Entity('n', 43, 4, 300));
    entities.push_back(Entity('r', 264, 4, 300));
    entities.push_back(Entity('n', 39, 5, 450));
    entities.push_back(Entity('r', 259, 5, 450));
    for (int i = 0; i < entities.size(); i++)
    {
        entities[i].spawn();
    }
    sf::RectangleShape hider_n_g(sf::Vector2f(50, 50));
    hider_n_g.setFillColor(sf::Color::Black);
    hider_n_g.setPosition(200, 600);
    sf::RectangleShape hider_r_g(sf::Vector2f(50, 50));
    hider_r_g.setFillColor(sf::Color::Black);
    hider_r_g.setPosition(200, 650);
    sf::RectangleShape hider_n_e(sf::Vector2f(50, 50));
    hider_n_e.setFillColor(sf::Color::Black);
    hider_n_e.setPosition(250, 600);
    sf::RectangleShape hider_r_e(sf::Vector2f(50, 50));
    hider_r_e.setFillColor(sf::Color::Black);
    hider_r_e.setPosition(250, 650);
    sf::RectangleShape hider_n_p(sf::Vector2f(50, 50));
    hider_n_p.setFillColor(sf::Color::Black);
    hider_n_p.setPosition(300, 600);
    sf::RectangleShape hider_r_p(sf::Vector2f(50, 50));
    hider_r_p.setFillColor(sf::Color::Black);
    hider_r_p.setPosition(300, 650);
    Townhall townhall_nature(25, 'n', side);
    Townhall townhall_robot(263, 'r', side);

    sf::Font turn_text;
    turn_text.loadFromFile("Fonts/file.ttf");
    sf::Text turn_t;
    turn_t.setFont(turn_text);
    turn_t.setCharacterSize(30);
    turn_t.setFillColor(sf::Color::Yellow);
    turn_t.move(800, 20);
    turn_t.setString("Nature's turn");
    window.draw(turn_t);
    sf::RectangleShape hider_turn(sf::Vector2f(300, 50));
    hider_turn.setFillColor(sf::Color::Black);
    hider_turn.setPosition(800, 20);


    sf::Sprite gold_stone;
    sf::Texture gold;
    gold.loadFromFile("Images\\gold_stone.png");
    gold_stone.setTexture(gold);
    gold_stone.setScale(0.3, 0.3);
    gold_stone.setPosition(180, 520);

    sf::Sprite etherium_stone;
    sf::Texture etherium;
    etherium.loadFromFile("Images\\etherium_stone.png");
    etherium_stone.setTexture(etherium);
    etherium_stone.setScale(0.2, 0.2);
    etherium_stone.setPosition(230, 520);

    sf::Sprite pandorium_stone;
    sf::Texture pandorium;
    pandorium.loadFromFile("Images\\pandorium_stone.png");
    pandorium_stone.setTexture(pandorium);
    pandorium_stone.setScale(0.2, 0.2);
    pandorium_stone.setPosition(280, 520);

    sf::Font balance;
    sf::Text balance_gold_text_n;
    sf::Text balance_gold_text_r;
    sf::Text balance_etherium_text_n;
    sf::Text balance_etherium_text_r;
    sf::Text balance_pandorium_text_n;
    sf::Text balance_pandorium_text_r;
    balance.loadFromFile("Fonts/file.ttf");
    balance_gold_text_n.setFont(balance);
    balance_gold_text_r.setFont(balance);
    balance_gold_text_n.setCharacterSize(20);
    balance_gold_text_r.setCharacterSize(20);
    balance_gold_text_n.setFillColor(sf::Color::Yellow);
    balance_gold_text_r.setFillColor(sf::Color::Yellow);
    balance_gold_text_n.move(200, 600);
    balance_gold_text_r.move(200, 650);

    balance_etherium_text_n.setFont(balance);
    balance_etherium_text_n.setCharacterSize(20);
    balance_etherium_text_n.setFillColor(sf::Color::Red);
    balance_etherium_text_n.move(250, 600);
    balance_etherium_text_r.setFont(balance);
    balance_etherium_text_r.setCharacterSize(20);
    balance_etherium_text_r.setFillColor(sf::Color::Red);
    balance_etherium_text_r.move(250, 650);

    balance_pandorium_text_n.setFont(balance);
    balance_pandorium_text_n.setCharacterSize(20);
    balance_pandorium_text_n.setFillColor(sf::Color(198, 115, 255));
    balance_pandorium_text_n.move(300, 600);
    balance_pandorium_text_r.setFont(balance);
    balance_pandorium_text_r.setCharacterSize(20);
    balance_pandorium_text_r.setFillColor(sf::Color(198, 115, 255));
    balance_pandorium_text_r.move(300, 650);

    balance_gold_text_n.setString(std::to_string(townhall_nature.return_balance_gold()));
    balance_etherium_text_n.setString(std::to_string(townhall_nature.return_balance_etherium()));
    balance_pandorium_text_n.setString(std::to_string(townhall_nature.return_balance_pandorium()));

    balance_gold_text_r.setString(std::to_string(townhall_robot.return_balance_gold()));
    balance_etherium_text_r.setString(std::to_string(townhall_robot.return_balance_etherium()));
    balance_pandorium_text_r.setString(std::to_string(townhall_robot.return_balance_pandorium()));
    bool capturing_n = false, capturing_r = false;
    int cnt_n = 2, cnt_r = 3;
    townhall_nature.update_gold(0);
    balance_gold_text_n.setString(std::to_string(townhall_nature.return_balance_gold()));
    sf::Vector2f p;
    int prev_i = 0;
    int cnt_gold, cnt_etherium, cnt_pandorium;

    int selectedEntityIndex = 1;
    while (window.isOpen())
    {
        sf::Vector2i pos = sf::Mouse::getPosition(window);
        sf::Event event;

        while (window.pollEvent(event))
        {

            if (event.type == sf::Event::Closed)
                window.close();

            if (event.type == sf::Event::MouseButtonPressed)
                if (event.mouseButton.button == sf::Mouse::Left)
                {
                    sf::Vector2i mousePosition = sf::Mouse::getPosition(window);
                    for (int i = 0; i < entities.size(); ++i)
                    {

                        if (entities[i].return_drawing().getGlobalBounds().contains(mousePosition.x, mousePosition.y))
                        {
                            prev_i = selectedEntityIndex;
                            selectedEntityIndex = i;
                            break;
                        }
                    }


                    if (button.getGlobalBounds().contains(mousePosition.x, mousePosition.y))
                    {

                        turn_cnt++;
                        if (turn_cnt % 2 == 0)
                        {
                            selected_team = 'r';
                            selectedEntityIndex = 0;
                        }
                        else
                        {
                            selected_team = 'n';
                            selectedEntityIndex = 1;
                        }
                        if (entities[selectedEntityIndex].return_tier() == 0 && (map[entities[selectedEntityIndex].return_i()].status != 'w'))
                        {
                            if (selected_team == 'n' && cnt_n >= 2 && map[entities[selectedEntityIndex].return_i()].status != 'n')
                            {
                                capturing_n = true;
                                cnt_n = 0;
                            }
                            else if (selected_team == 'r' && cnt_r >= 2 && map[entities[selectedEntityIndex].return_i()].status != 'r')
                            {
                                capturing_r = true;
                                cnt_r = 0;
                            }
                        }


                        if (selected_team == 'n')
                        {

                            cnt_n++;
                            turn_t.setString("Nature's turn");
                            if (map[19].status == 'l') cnt_gold++;
                            if (map[257].status == 'l') cnt_gold++;
                            townhall_nature.update_gold(cnt_gold);
                            if (map[84].status == 'l') cnt_etherium++;
                            if (map[220].status == 'l') cnt_etherium++;
                            townhall_nature.update_etherium(cnt_etherium);
                            if (map[148].status == 'l') cnt_pandorium++;
                            townhall_nature.update_pandorium(cnt_pandorium);
                            balance_gold_text_n.setString(std::to_string(townhall_nature.return_balance_gold()));
                            balance_etherium_text_n.setString(std::to_string(townhall_nature.return_balance_etherium()));
                            balance_pandorium_text_n.setString(std::to_string(townhall_nature.return_balance_pandorium()));
                            cnt_gold = 0;
                            cnt_etherium = 0;
                            cnt_pandorium = 0;

                        }
                        else
                        {
                            cnt_r++;
                            turn_t.setString("Robot's turn");
                            if (map[19].status == 'd') cnt_gold++;
                            if (map[257].status == 'd') cnt_gold++;
                            townhall_robot.update_gold(cnt_gold);
                            if (map[84].status == 'd') cnt_etherium++;
                            if (map[220].status == 'd') cnt_etherium++;
                            townhall_robot.update_etherium(cnt_etherium);
                            if (map[148].status == 'd') cnt_pandorium++;
                            townhall_robot.update_pandorium(cnt_pandorium);
                            balance_gold_text_r.setString(std::to_string(townhall_robot.return_balance_gold()));
                            balance_etherium_text_r.setString(std::to_string(townhall_robot.return_balance_etherium()));
                            balance_pandorium_text_r.setString(std::to_string(townhall_robot.return_balance_pandorium()));
                            cnt_gold = 0;
                            cnt_etherium = 0;
                            cnt_pandorium = 0;


                        }
                        if (cnt_n == 2 && capturing_n && entities[selectedEntityIndex].return_tier() == 0)
                        {
                            if (map[entities[selectedEntityIndex].return_i()].status == 'g' || map[entities[selectedEntityIndex].return_i()].status == 'r')
                                map[entities[selectedEntityIndex].return_i()].status = 'n';
                            else if (map[entities[selectedEntityIndex].return_i()].status == 'e' || map[entities[selectedEntityIndex].return_i()].status == 'a' || map[entities[selectedEntityIndex].return_i()].status == 'p' || map[entities[selectedEntityIndex].return_i()].status == 'd')
                                map[entities[selectedEntityIndex].return_i()].status = 'l';
                            capturing_n = false;
                            // l - life для природи захоплених шахт
                        }
                        if (cnt_r == 2 && capturing_r && entities[selectedEntityIndex].return_tier() == 0)
                        {
                            if (map[entities[selectedEntityIndex].return_i()].status == 'g' || map[entities[selectedEntityIndex].return_i()].status == 'n')
                                map[entities[selectedEntityIndex].return_i()].status = 'r';
                            else if (map[entities[selectedEntityIndex].return_i()].status == 'e' || map[entities[selectedEntityIndex].return_i()].status == 'a' || map[entities[selectedEntityIndex].return_i()].status == 'p' || map[entities[selectedEntityIndex].return_i()].status == 'l')
                                map[entities[selectedEntityIndex].return_i()].status = 'd';
                            capturing_r = false;
                            //d - death для роботів захоплених шахт
                        }
                        for (int i = 0; i < entities.size(); i++)
                        {
                            entities[i].turns_set_to();
                        }

                        std::cout << map[148].status << ' ' << map[84].status << '\n';
                    }





                }



            entities[prev_i].spawn();


            if (selectedEntityIndex != -1)
            {

                if (selected_team == entities[selectedEntityIndex].return_team())
                {

                    if (entities[selectedEntityIndex].return_tier() == 0)
                    {
                        if (selected_team == 'n' && capturing_n)
                            allow_move = false;
                        else if (selected_team == 'r' && capturing_r)
                            allow_move = false;
                        else allow_move = true;
                    }
                    else allow_move = true;
                }
                else allow_move = false;

                if (event.type == sf::Event::KeyPressed)
                {
                    if (entities[selectedEntityIndex].return_turns() > 0 && allow_move)
                    {
                        if (event.key.code == sf::Keyboard::Z)
                        {



                            if (entities[selectedEntityIndex].move_Z(left_border, right_border, upper_border, down_border, entities[selectedEntityIndex]))
                                entities[selectedEntityIndex].decrease_turns();


                        }
                        else if (event.key.code == sf::Keyboard::X)
                        {


                            if (entities[selectedEntityIndex].move_X(left_border, right_border, upper_border, down_border, entities[selectedEntityIndex]))
                                entities[selectedEntityIndex].decrease_turns();

                        }
                        else if (event.key.code == sf::Keyboard::A)
                        {


                            if (entities[selectedEntityIndex].move_A(left_border, right_border, upper_border, down_border, entities[selectedEntityIndex]))
                                entities[selectedEntityIndex].decrease_turns();

                        }
                        else if (event.key.code == sf::Keyboard::W)
                        {


                            if (entities[selectedEntityIndex].move_W(left_border, right_border, upper_border, down_border, entities[selectedEntityIndex]))
                                entities[selectedEntityIndex].decrease_turns();

                        }
                        else if (event.key.code == sf::Keyboard::E)
                        {


                            if (entities[selectedEntityIndex].move_E(left_border, right_border, upper_border, down_border, entities[selectedEntityIndex]))
                                entities[selectedEntityIndex].decrease_turns();

                        }
                        else if (event.key.code == sf::Keyboard::D)
                        {


                            if (entities[selectedEntityIndex].move_D(left_border, right_border, upper_border, down_border, entities[selectedEntityIndex]))
                                entities[selectedEntityIndex].decrease_turns();


                        }
                    }
                }




            }
        }





        build_map(side, numberOfHexagons_horizontal, numberOfHexagons_vertical, sign, startX, startY, window);
        townhall_nature.draw(window);
        townhall_robot.draw(window);
        Hut barracks_nature(42, 'n', side);
        balance_g = townhall_nature.return_balance_gold();
        //barracks_nature.buy(window, balance_g, clock);
        Hut barracks_robot(210, 'r', side);
        balance_g = townhall_robot.return_balance_gold();
        //barracks_robot.buy(window, balance_g, clock);
        instructions(window, button);
        for (int i = 0; i < entities.size(); i++)
        {
            window.draw(entities[i].return_drawing());
        }

        window.draw(entities[selectedEntityIndex].return_drawing());
        window.draw(hider_n_g);
        window.draw(balance_gold_text_n);
        window.draw(hider_r_g);
        window.draw(balance_gold_text_r);
        window.draw(hider_n_e);
        window.draw(balance_etherium_text_n);
        window.draw(hider_r_e);
        window.draw(balance_etherium_text_r);
        window.draw(hider_n_p);
        window.draw(balance_pandorium_text_n);
        window.draw(hider_r_p);
        window.draw(balance_pandorium_text_r);
        window.draw(gold_stone);
        window.draw(etherium_stone);
        window.draw(pandorium_stone);
        window.draw(hider_turn);
        window.draw(turn_t);
        window.display();

    }
    return 0;
}
