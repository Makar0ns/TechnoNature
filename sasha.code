class Hut
{
private:
    int side;
    int hp;
    char team;
    bool is_destroyed;
    int i;
    int unit_tier;
    int build_price = 5;
    sf::Texture texture;
    sf::CircleShape hexagon;
    sf::Text text;
    sf::Font font;



public:
    Hut(int in_i, char team_in, int in_side)
    {
        i = in_i;
        team = team_in;
        side = in_side;


    }
    void buy(sf::RenderWindow& window, int balance_gold, sf::Clock& clock)
    {
        if (balance_gold >= build_price)
        {
            sf::CircleShape hexagon(side, 6);
            if (team == 'n')
                texture.loadFromFile("Images\\barracks_nature.png");
            else texture.loadFromFile("Images\\barracks_robot.png");
            hexagon.setPosition(map[i].x, map[i].y);
            hexagon.setTexture(&texture);
            window.draw(hexagon);
        }
        else
        {
            sf::RectangleShape rect(sf::Vector2f(0, 0));
            rect.setFillColor(sf::Color::Black);
            rect.setSize(sf::Vector2f(400, 100));
            font.loadFromFile("Fonts/file.ttf");
            text.setFont(font);
            text.setCharacterSize(24);
            text.setString("NOT ENOUGH RESOURSES");
            text.setFillColor(sf::Color::Red);
            text.move(0, 0);
            window.draw(text);
            if (clock.getElapsedTime().asSeconds() >= 3)
            {
                window.draw(rect);
            }
        }
    }
    void change_hp(int damage)
    {
        hp -= damage;
        if (hp < 1) is_destroyed = true;
    }
};
class Entity
{
private:
    char team;
    int i;
    int unit_tier;
    int hp;
    int i_nature;
    sf::Sprite unit;
    sf::Texture texture;
    sf::Texture grey;
    int prev_i;
    sf::Vector2f p;
    bool check = true;
    int turns_left = 1;
public:
    Entity(char in_team, int in_i, int unit_tier_in, int hp_in)
    {
        i = in_i;
        team = in_team;
        unit_tier = unit_tier_in;
        hp = hp_in;
    }
    void spawn()
    {
        if (unit_tier == 0 && team == 'r')
        {
            texture.loadFromFile("images/robot_worker.png");
        }
        else if (unit_tier == 0 && team == 'n')
        {
            texture.loadFromFile("images/worker_nature.png");
        }
        else if (unit_tier == 1 && team == 'n')
        {
            texture.loadFromFile("images/warrior_nature1.png");
        }
        else if (unit_tier == 1 && team == 'r')
        {
            texture.loadFromFile("images/warrior_robot.png");
        }
        else if (unit_tier == 2 && team == 'n')
        {
            texture.loadFromFile("images/archer_nature.png");
        }
        else if (unit_tier == 2 && team == 'r')
        {
            texture.loadFromFile("images/archer_robot.png");
        }
        else if (unit_tier == 3 && team == 'n')
        {
            texture.loadFromFile("images/healer_nature.png");
        }
        else if (unit_tier == 3 && team == 'r')
        {
            texture.loadFromFile("images/healer_robot.png");
        }
        else if (unit_tier == 4 && team == 'n')
        {
            texture.loadFromFile("images/artillery_nature.png");
        }
        else if (unit_tier == 4 && team == 'r')
        {
            texture.loadFromFile("images/artillery_robot.png");
        }
        else if (unit_tier == 5 && team == 'n')
        {
            texture.loadFromFile("images/troophorse_nature.png");
        }
        else if (unit_tier == 5 && team == 'r')
        {
            texture.loadFromFile("images/troophorse_robot.png");
        }

        unit.setTexture(texture);
        unit.setScale(0.19, 0.19);
        unit.setPosition(map[i].x + hor_space, map[i].y + ver_space);
    }
    sf::Sprite& return_drawing()
    {
        return unit;
    }
    int return_i()
    {
        return i;
    }
    void change(int in_i)
    {
        i = in_i;
    }
    char return_team()
    {
        return team;
    }
    int return_turns()
    {
        return turns_left;
    }
    void decrease_turns()
    {
        turns_left--;
    }
    void turns_set_to()
    {
        turns_left = 1;
    }
    int return_tier()
    {
        return unit_tier;
    }
    bool move_Z(float left_border, float right_border, float upper_border, float down_border, Entity& entity)
    {
        check = true;
        sf::Vector2f position = entity.return_drawing().getPosition();
        float distance = side * sqrt(3) - 3;
        if (position.x - distance<left_border || position.y + distance >down_border) return false;
        if (check)
        {
            p = entity.return_drawing().getPosition();
            prev_i = entity.return_i();
            entity.return_drawing().move((sqrt(3) * side * cos(120.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(120.0f * 3.14159f / 180.0f)));
            if (abs(int(entity.return_drawing().getPosition().x - map[entity.return_i() + 1].x)) <= horiz_shift && abs(int(entity.return_drawing().getPosition().y - map[entity.return_i() + 1].y)) <= vert_shift)
                entity.change(entity.return_i() + 1);
            else entity.change(entity.return_i() - 16);

            if (map[entity.return_i()].status == 'w')
            {
                entity.return_drawing().setPosition(p);
                entity.change(prev_i);
                return false;

            }
        }
        return true;

    }
    bool move_X(float left_border, float right_border, float upper_border, float down_border, Entity& entity)
    {
        check = true;
        sf::Vector2f position = entity.return_drawing().getPosition();
        float distance = side * sqrt(3) - 3;
        if (position.x + distance > right_border || position.y + distance > down_border) return false;
        if (check)
        {
            p = entity.return_drawing().getPosition();
            prev_i = entity.return_i();
            entity.return_drawing().move((sqrt(3) * side * cos(60.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(60.0f * 3.14159f / 180.0f)));
            if (abs(int(map[entity.return_i() + 1].x - entity.return_drawing().getPosition().x)) <= horiz_shift && abs(int(map[entity.return_i() + 1].y - entity.return_drawing().getPosition().y) <= vert_shift))
                entity.change(entity.return_i() + 1);
            else entity.change(entity.return_i() + 18);
            if (map[entity.return_i()].status == 'w')
            {
                entity.return_drawing().setPosition(p);
                entity.change(prev_i);
                return false;
            }
        }
        return true;
    }
    bool move_D(float left_border, float right_border, float upper_border, float down_border, Entity& entity)
    {
        check = true;
        sf::Vector2f position = entity.return_drawing().getPosition();
        float distance = side * sqrt(3) + 5;
        if (position.x + distance > right_border)
            return false;
        if (check)
        {
            p = entity.return_drawing().getPosition();
            prev_i = entity.return_i();
            entity.return_drawing().move((sqrt(3) * side * cos(0.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(0.0f * 3.14159f / 180.0f)));
            entity.change(entity.return_i() + 17);
            if (map[entity.return_i()].status == 'w')
            {
                entity.return_drawing().setPosition(p);
                entity.change(prev_i);
                return false;
            }
        }
        return true;
    }
    bool move_E(float left_border, float right_border, float upper_border, float down_border, Entity& entity)
    {
        check = true;
        sf::Vector2f position = entity.return_drawing().getPosition();
        float distance = side * sqrt(3), vert_distance = side * sqrt(3) * 2;
        if (position.x + distance > right_border || position.y - vert_distance < upper_border)
            return false;
        if (check)
        {
            p = entity.return_drawing().getPosition();
            prev_i = entity.return_i();
            entity.return_drawing().move((sqrt(3) * side * cos(300.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(300.0f * 3.14159f / 180.0f)));
            if (abs(int(map[entity.return_i() - 1].x - entity.return_drawing().getPosition().x)) <= horiz_shift && abs(int(map[entity.return_i() - 1].y - entity.return_drawing().getPosition().y) <= vert_shift))
                entity.change(entity.return_i() - 1);
            else entity.change(entity.return_i() + 16);
            if (map[entity.return_i()].status == 'w')
            {
                entity.return_drawing().setPosition(p);
                entity.change(prev_i);
                return false;
            }
        }
        return true;
    }
    bool move_W(float left_border, float right_border, float upper_border, float down_border, Entity& entity)
    {
        check = true;
        sf::Vector2f position = entity.return_drawing().getPosition();
        float distance = side * sqrt(3), vert_distance = side * sqrt(3) * 2;
        if (position.x - distance < left_border || position.y - vert_distance < upper_border)
            return false;
        if (check)
        {
            p = entity.return_drawing().getPosition();
            prev_i = entity.return_i();
            entity.return_drawing().move((sqrt(3) * side * cos(240.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(240.0f * 3.14159f / 180.0f)));
            if (abs(int(map[entity.return_i() - 1].x - entity.return_drawing().getPosition().x)) <= horiz_shift && abs(int(map[entity.return_i() - 1].y - entity.return_drawing().getPosition().y) <= vert_shift))
                entity.change(entity.return_i() - 1);
            else entity.change(entity.return_i() - 18);
            if (map[entity.return_i()].status == 'w')
            {
                entity.return_drawing().setPosition(p);
                entity.change(prev_i);
                return false;
            }
        }
        return true;
    }
    bool move_A(float left_border, float right_border, float upper_border, float down_border, Entity& entity)
    {
        check = true;
        sf::Vector2f position = entity.return_drawing().getPosition();
        float distance = side * sqrt(3) * 1.5;
        if (position.x - distance < left_border)
            return false;
        if (check)
        {
            p = entity.return_drawing().getPosition();
            prev_i = entity.return_i();
            entity.return_drawing().move((sqrt(3) * side * cos(180.0f * 3.14159f / 180.0f)), (sqrt(3) * side * sin(180.0f * 3.14159f / 180.0f)));
            entity.change(entity.return_i() - 17);
            if (map[entity.return_i()].status == 'w')
            {
                entity.return_drawing().setPosition(p);
                entity.change(prev_i);
                return false;
            }
        }
        return true;
    }
};
