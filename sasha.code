    menu.setFillColor(sf::Color::Black);
    menu.setPosition(1440, 73);
    menu.setOutlineThickness(10.f);
    menu.setOutlineColor(sf::Color(216, 178, 129));
    font.loadFromFile("Fonts/file.ttf");
